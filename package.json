{
  "name": "daynight",
  "version": "4.2.0",
  "description": "Is it light or dark where your user is? Find out without asking them, in 6.9 KB. No permission prompt, no IP lookup, no network request.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:land": "node scripts/generate-land.mjs",
    "generate:zones": "node scripts/generate-zones.mjs",
    "generate:og": "node scripts/generate-og.mjs",
    "generate:hero": "node scripts/generate-hero.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "build:cjs": "esbuild src/index.ts --bundle --minify --sourcemap --target=es2018 --format=cjs --platform=node --outfile=dist/cjs/index.js",
    "build:esm": "esbuild src/index.ts --bundle --minify --sourcemap --target=es2018 --format=esm --outfile=dist/esm/index.js",
    "build:types": "tsc --emitDeclarationOnly --outDir dist/types",
    "build": "rm -rf dist && npm run build:cjs && npm run build:esm && npm run build:types",
    "prepublishOnly": "npm run build",
    "start": "tsc --watch"
  },
  "keywords": [
    "sunrise",
    "sunset",
    "sun",
    "dark mode"
  ],
  "author": "Roman Yanke <roman@yanke.world>",
  "license": "MIT",
  "homepage": "https://romanyanke.github.io/daynight/",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "jsts": "2.12.1",
    "prettier": "3.9.6",
    "typescript": "6.0.2",
    "vitest": "4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/romanyanke/daynight.git"
  },
  "files": [
    "dist"
  ]
}
